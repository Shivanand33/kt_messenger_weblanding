# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────────
# When using the bundled docker-compose: user=kt password=kt db=kt_messenger
DATABASE_URL="postgresql://kt:kt@localhost:5432/kt_messenger?schema=public"

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# ─── First super admin (used by the seed script) ─────────
SEED_ADMIN_EMAIL="admin@ktmessenger.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Super Admin"

# ─── CORS (comma-separated origins allowed to call the API) ─
# Public website + Admin panel dev servers
CORS_ORIGINS="http://localhost:5174,http://localhost:5173"
FRONTEND_URL="http://localhost:5174"
ADMIN_URL="http://localhost:5173"

# ─── Media storage ────────────────────────────────────────
# Provider: "local" (default) writes to ./uploads and serves at /uploads
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads"
MEDIA_PUBLIC_URL="http://localhost:4000/uploads"
MAX_UPLOAD_MB=10

# ─── Email (used by admin "reply to contact message") ────
# "log"  = prints the email to the server console, delivers nothing (default).
# "smtp" = really sends. Requires: npm i nodemailer  + the SMTP_* vars below.
EMAIL_PROVIDER="log"
EMAIL_FROM="KT Messenger <no-reply@ktmessenger.local>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
