# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────────
# When using the bundled docker-compose: user=kt password=kt db=kt_messenger
DATABASE_URL="postgresql://kt:kt@localhost:5432/kt_messenger?schema=public"

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# ─── First super admin (used by the seed script) ─────────
SEED_ADMIN_EMAIL="admin@ktmessenger.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Super Admin"

# ─── CORS (comma-separated origins allowed to call the API) ─
# Public website + Admin panel dev servers
CORS_ORIGINS="http://localhost:5174,http://localhost:5173"
FRONTEND_URL="http://localhost:5174"
ADMIN_URL="http://localhost:5173"

# ─── Media storage ────────────────────────────────────────
# Provider: "local" writes to ./uploads and serves at /uploads.
#           "r2" uploads to Cloudflare R2 (fill the R2_* values below first).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads"
MEDIA_PUBLIC_URL="http://localhost:4000/uploads"
MAX_UPLOAD_MB=10

# ─── Cloudflare R2 (S3-compatible) ────────────────────────
# To use R2: fill these in, then set STORAGE_PROVIDER="r2" above.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Public URL of the bucket (r2.dev URL or custom domain, no trailing slash)
R2_PUBLIC_URL=""

# ─── Email (used by admin "reply to contact message") ────
# "log"  = prints the email to the server console, delivers nothing (default).
# "smtp" = really sends. Requires: npm i nodemailer  + the SMTP_* vars below.
EMAIL_PROVIDER="log"
EMAIL_FROM="KT Messenger <no-reply@ktmessenger.local>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
