# Public website → backend API base URL.
# Used only by src/services/apiClient.js when a page opts into the API.
# Leave unset to keep the site fully static (current default behaviour).
VITE_API_URL=http://localhost:4000/api

# Canonical origin for the public site, used to build canonical links and
# Open Graph / Twitter URLs (e.g. https://ktmessenger.com/blog/<slug>).
# When unset the site falls back to the browser's own origin, which keeps
# staging and preview builds from advertising production URLs.
VITE_SITE_URL=https://ktmessenger.com
